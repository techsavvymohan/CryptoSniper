# ------------------------------------------------------------------------------
# Solana MEV Arbitrage Bot - Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env to version control.
# ------------------------------------------------------------------------------

# === Connectivity ===
# gRPC endpoint: domain:port format ONLY — no https://
HELIUS_GRPC_URL=mainnet.helius-rpc.com:443
HELIUS_API_KEY=your_helius_api_key_here

# === Database (PostgreSQL — native localhost) ===
DATABASE_URL=postgresql://mev_user:mev_pass@localhost:5432/mev_research

# === Cache & Events (Redis — native localhost) ===
REDIS_URL=redis://localhost:6379

# === Wallet & Authentication ===
BOT_WALLET_PRIVATE_KEY=your_trading_wallet_private_key_base58
JITO_AUTH_KEYPAIR=your_jito_searcher_keypair_base58

# === Jito Block Engine ===
# domain:port format ONLY — no https://
JITO_BLOCK_ENGINE_URL=mainnet.block-engine.jito.wtf:443

# === Execution Strategy ===
SIMULATION_MODE=true
MIN_NET_PROFIT_BPS=20
DAILY_LOSS_LIMIT_USDC=100
MAX_TRADE_CAPITAL_USDC=50
JITO_TIP_RATIO=0.30
COMPETITION_LEVEL=medium

# === API Server ===
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# === Telegram (Remote Control & Alerts) ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated for multiple admins: 123456789,987654321
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_here

# === Logging ===
LOG_LEVEL=info

# === Monitoring ===
PROMETHEUS_PORT=9091
