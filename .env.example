# ------------------------------------------------------------------------------
# Solana MEV Arbitrage Bot & The Godfather Quantitative Fund
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env to version control.
# ------------------------------------------------------------------------------

# === Execution Mode ===
# Set to 'true' to run 100% Standalone in RAM with ZERO PostgreSQL and ZERO Redis needed!
STANDALONE_MODE=true

# === Connectivity (Solana Engine 1) ===
# gRPC endpoint: domain:port format ONLY — no https://
HELIUS_GRPC_URL=mainnet.helius-rpc.com:443
HELIUS_API_KEY=your_helius_api_key_here

# === Multi-Region Yellowstone Geyser Streams ===
GEYSER_REGIONS_ENABLED=false
HELIUS_GRPC_AMS=amsterdam.helius-rpc.com:443
HELIUS_GRPC_TYO=tokyo.helius-rpc.com:443
HELIUS_GRPC_EWR=mainnet.helius-rpc.com:443

# === Database (PostgreSQL — native localhost) ===
DATABASE_URL=postgresql://mev_user:mev_pass@localhost:5432/mev_research

# === Cache & Events (Redis — native localhost) ===
REDIS_URL=redis://localhost:6379

# === Solana Wallet & Authentication (Engine 1) ===
BOT_WALLET_PRIVATE_KEY=your_trading_wallet_private_key_base58
JITO_AUTH_KEYPAIR=your_jito_searcher_keypair_base58

# === Jito Block Engine & Leader-Aware Multi-Region Routing ===
JITO_BLOCK_ENGINE_URL=mainnet.block-engine.jito.wtf:443
JITO_MULTI_REGION_ROUTING=true
JITO_ENDPOINTS_AMS=amsterdam.mainnet.block-engine.jito.wtf:443
JITO_ENDPOINTS_TYO=tokyo.mainnet.block-engine.jito.wtf:443
JITO_ENDPOINTS_NY=ny.mainnet.block-engine.jito.wtf:443

# === Solana MEV Execution Strategy (Engine 1) ===
SIMULATION_MODE=true
MIN_NET_PROFIT_BPS=20
DAILY_LOSS_LIMIT_USDC=100
MAX_TRADE_CAPITAL_USDC=50
JITO_TIP_RATIO=0.30
COMPETITION_LEVEL=medium

# === Engine 2: The GODFATHER Quantitative Directional Scalper ===
GODFATHER_ENABLED=true
GODFATHER_SYMBOLS=BTCUSD,ETHUSD,SOLUSD,DOGEUSD,SUIUSD,AVAXUSD,NEARUSD,LINKUSD,APTUSD,ARBUSD,OPUSD,WIFUSD,PEPEUSD,TIAUSD,INJUSD

# Directional Venue Selection: 'hyperliquid' | 'bybit' | 'paper'
DIRECTIONAL_VENUE=hyperliquid
DIRECTIONAL_TESTNET=true

# Hyperliquid Credentials (Primary Venue - EIP-712 Non-Custodial Agent Wallet)
HYPERLIQUID_WALLET_PRIVATE_KEY=your_agent_evm_private_key_hex
HYPERLIQUID_VAULT_ADDRESS=your_main_account_address_hex

# Bybit V5 Credentials (Secondary CEX Fallback - Unified Trading Account)
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret

# Godfather Microstructure & Risk Parameters
BTC_SWEEP_MIN_BREACH_USD=50.0
SOL_SWEEP_MIN_BREACH_USD=0.50
BTC_RETEST_MAX_BARS=8
SOL_RETEST_MAX_BARS=15
CONVICTION_SCALE_A_PLUS=2.40
CONVICTION_SCALE_A=1.00
CONVICTION_SCALE_B=0.50
WEEKEND_RISK_SCALE=0.50
WEEKEND_BREAKEVEN_TRIGGER_R=1.40
GODFATHER_DAILY_LOSS_LIMIT_USDC=450.0
MAX_ACCOUNT_DD_PCT=9.0
CORRELATED_USD_RISK_SCALE=0.60
BASE_RISK_PCT=0.85

# === Sub-Second Hyperliquid Tick Footprint (VWAP Delta & OBI) ===
HYPERLIQUID_FOOTPRINT_ENABLED=true
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
FOOTPRINT_ROLLING_WINDOW_SECS=60
OBI_LEVEL_DEPTH=5

# === API Server ===
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# === Telegram (Remote Control & Alerts) ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated for multiple admins: 123456789,987654321
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_here

# === Logging ===
LOG_LEVEL=info

# === Monitoring ===
PROMETHEUS_PORT=9091
