{
  "name": "solana-arbitrage-bot",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "migrate": "pnpm --filter @mev-research/database migrate",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-local.ps1",
    "redis": "powershell -ExecutionPolicy Bypass -File scripts/start-redis.ps1",
    "start": "pnpm --filter @mev-research/main start",
    "dev": "pnpm --filter @mev-research/main dev",
    "dashboard": "pnpm --filter dashboard dev"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bigint-buffer",
      "bufferutil",
      "protobufjs",
      "utf-8-validate"
    ],
    "overrides": {
      "@solana/web3.js": "1.98.4",
      "jito-ts>@solana/web3.js": "1.98.4"
    }
  }
}
